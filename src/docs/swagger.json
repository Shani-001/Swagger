{
  "openapi": "3.0.3",
  "info": {
    "title": "Employee REST API",
    "version": "1.0.0",
    "description": "REST API for managing employee records, built with Node.js & Express."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "summary": "Retrieve all employees",
        "description": "Returns a list of all employees. Supports optional case-insensitive department filtering.",
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Optional department name to filter by (e.g., Engineering, HR)",
            "schema": {
              "type": "string",
              "example": "Engineering"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of employees retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a new employee",
        "description": "Creates a new employee record with auto-generated unique ID and default status 'Active'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employee created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (missing or empty name/department)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "summary": "Retrieve an employee by ID",
        "description": "Returns a single employee record matching the given ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the employee",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          },
          "404": {
            "description": "Employee not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/employees/{id}/status": {
      "patch": {
        "summary": "Update an employee's status",
        "description": "Updates an existing employee's status. Allowed values are 'Active' or 'Inactive'.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the employee",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employee status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          },
          "404": {
            "description": "Employee not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid status value provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Rahul Sharma"
          },
          "department": {
            "type": "string",
            "example": "Engineering"
          },
          "status": {
            "type": "string",
            "enum": ["Active", "Inactive"],
            "example": "Active"
          }
        },
        "required": ["id", "name", "department", "status"]
      },
      "EmployeeCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ananya Roy"
          },
          "department": {
            "type": "string",
            "example": "Marketing"
          }
        },
        "required": ["name", "department"]
      },
      "EmployeeStatusUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["Active", "Inactive"],
            "example": "Inactive"
          }
        },
        "required": ["status"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Employee with ID 999 not found"
          }
        },
        "required": ["error"]
      }
    }
  }
}
